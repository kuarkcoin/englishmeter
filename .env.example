# Server-only PostgreSQL URL. Required for Global English Challenge; install its
# tables with npm run db:challenge. See docs/global-challenge.md for Vercel setup.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# Contact email: set these securely in the hosting provider's environment settings.
# Use an address on a domain verified in Resend, not the visitor's email or a Gmail sender.
RESEND_API_KEY=""
CONTACT_FROM_EMAIL=""
